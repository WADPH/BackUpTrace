# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env file.

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_DB=backuptrace
POSTGRES_USER=backuptrace
# Set is only once, then leave it alone. Changing it later will break existing integration. If you need to change it, use:
# docker exec -it backuptrace-postgres psql -U backuptrace -d backuptrace -c "ALTER USER backuptrace WITH PASSWORD 'new-password';"
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_HOST=postgres
# The single source of truth for Postgres's port -- it's what Postgres
# actually listens on inside its container, what the API connects to, and
# (if you uncomment the `ports:` mapping on the postgres service in
# docker-compose.yml to let an external Grafana connect directly) the
# host-side port too. Change it here only; nothing else needs editing.
# Unlike POSTGRES_PASSWORD, this can be changed anytime and just takes
# effect on the next `docker compose up` -- it's a startup flag, not
# something baked into the database at initdb time.
POSTGRES_PORT=5432

# --- API service ----------------------------------------------------------
# Port the API is published on the host.
API_PORT=8000

# Optional: a single admin key that can query GET /api/v1/backup-events
# across ALL sources (useful for debugging via curl). Leave blank to disable
# cross-source reads entirely. Generate with e.g. `openssl rand -base64 32`.
ADMIN_API_KEY=

# Optional: max size in bytes for the `extra` JSONB payload on ingestion.
MAX_EXTRA_BYTES=16384

# --- Grafana (only used if you uncomment the grafana service in
#     docker-compose.yml -- disabled by default so you can point your own
#     external Grafana at this stack's Postgres instead) -------------------
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-too
